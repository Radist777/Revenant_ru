TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Необязательно. Список разрешённых Origin через запятую — запросы с других
# источников получат 403. Если строка не задана (или после trim в ней ничего
# не осталось), проверка не выполняется. Указывать домен сайта как его видит
# браузер, со схемой; лишние пробелы, завершающий слэш и регистр не мешают.
# ALLOWED_ORIGIN=https://revenant.ru,https://www.revenant.ru
